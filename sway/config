# Read `man 5 sway` for a complete reference.
#calibration has resolution dependent cursor shortcuts
include calibration
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK

### Variables
  set $mod Mod4
  set $left h
  set $down j
  set $up k
  set $right l
  set $gnome-schema org.gnome.desktop.interface
  set $slow 3
  set $fast 24

exec_always {
    gsettings set $gnome-schema color-scheme 'prefer-dark'
    #gsettings set $gnome-schema cursor-theme 'Your cursor Theme'
    #gsettings set $gnome-schema font-name 'Your font name'
}
exec sworkstyle &> /tmp/sworkstyle.log
exec amixer set Capture off
exec keyd-application-mapper &

## Gaps
  gaps inner 0
  gaps outer 0
  default_border pixel 1
  smart_gaps on
  for_window [app_id="gnome-calendar"] floating enabled

font pango:monospace 0.01
titlebar_border_thickness 0
titlebar_padding 0

###############################################################################
# MAKE ALL POSITIONAL! Letters meant to not mean ANYTHING! just QWERTY (for now)
###############################################################################

### Input configuration
# get names of inputs: swaymsg -t get_inputs
# `man 5 sway-input` for more info
input type:keyboard {
    #( changed to ~/.xkb/symbols/rctl_remapped_rwin)
    xkb_layout "us"
    xkb_variant altgr-intl 
    xkb_options "numpad:mac"
    repeat_delay 280
    repeat_rate 35
}

input type:touchpad {
    tap enabled
    middle_emulation disabled
}

### Key bindings
################################3

# Media/Hardware control
bindsym XF86AudioMute                 exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym Mod4+m                        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked Mod4+comma           exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ 
bindsym --locked Mod4+period          exec wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ 
bindsym XF86AudioMicMute              exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym Mod4+n                        exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym Print  exec grim -g "$(slurp)" - | swappy -f -
bindsym --locked XF86MonBrightnessUp exec light -T 1.4
bindsym --locked Mod4+q              exec light -T 1.4
bindsym --locked XF86MonBrightnessDown exec light -T 0.72
bindsym --locked Mod4+a                exec light -T 0.72

# Start a terminal
bindsym Mod4+Return exec kitty

bindsym Mod4+F5 reload
bindsym Mod4+Shift+r reload  # backup in case no fn keys available

bindsym F11 fullscreen
bindsym Mod4+Shift+f fullscreen

bindsym Mod4+backslash mode "resize"

# Launcher. Note: it's recommended that you pass the final command to sway
# bindsym Mod4+o exec bemenu-run --fn "VictorMono Nerd Font 20" | xargs swaymsg exec --
bindsym Mod4+r exec fuzzel -f=VictorMonoNerdFont:size=17 --icon-theme=Papirus --anchor=top --show-actions --layer=overlay --background=000000dd
# Exit sway (log out of Wayland session)
bindsym Mod4+Shift+y exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -b 'Yes, exit sway' 'swaymsg exit'

# Kill focused window
bindsym Mod1+F4 kill

# Move the currently focused window to the scratchpad
bindsym $mod+grave move scratchpad

# Show the next scratchpad window or hide the focused scratchpad window.
# If there are multiple SCRATCHPAD WINDOWS, THIS COMMAND CYCLES through them.
bindsym $mod+Mod1+grave scratchpad show

# Move window focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Mod5+Left  move left
bindsym $mod+Mod5+Down  move down
bindsym $mod+Mod5+Up    move up
bindsym $mod+Mod5+Right move right

###
# Workspaces (number is needed for sworkstyle, TODO: somehow label workspaces by letter)
#
  # Switch to workspace
  bindsym $mod+1 workspace number 1
  bindsym $mod+2 workspace number 2
  bindsym $mod+3 workspace number 3
  bindsym $mod+4 workspace number 4
  bindsym $mod+5 workspace number 5
  bindsym $mod+6 workspace number 6
  bindsym $mod+7 workspace number 7
  bindsym $mod+8 workspace number 8
  bindsym $mod+9 workspace number 9
  bindsym $mod+0 workspace number 10
  bindsym $mod+minus workspace number 11
  bindsym $mod+equal workspace number 12
  # Move focused container to workspace
  bindsym $mod+Mod1+1 move container to workspace number 1
  bindsym $mod+Mod1+2 move container to workspace number 2
  bindsym $mod+Mod1+3 move container to workspace number 3
  bindsym $mod+Mod1+4 move container to workspace number 4
  bindsym $mod+Mod1+5 move container to workspace number 5
  bindsym $mod+Mod1+6 move container to workspace number 6
  bindsym $mod+Mod1+7 move container to workspace number 7
  bindsym $mod+Mod1+8 move container to workspace number 8
  bindsym $mod+Mod1+9 move container to workspace number 9
  bindsym $mod+Mod1+0 move container to workspace number 10
  bindsym $mod+Mod1+minus move container to workspace number 11
  bindsym $mod+Mod1+equal move container to workspace number 12
  # Note: workspaces can have any name you want, not just numbers.
  # We just use 1-10 as the default.
 #

  ###
  # LAYOUT:
  # split focused window   [g]  | 'cause right of right index 
  #  (qwerty version)      [/]  _ 'cause down for left pinkie 
  bindsym $mod+Mod1+Right split horizontal
  bindsym $mod+Mod1+Down  split vertical
  # Switch the current container between different layout styles
  bindsym $mod+Mod1+Up    layout tabbed
  bindsym $mod+Mod1+Left  layout toggle split
  # Move focus to the parent container
  bindsym $mod+bracketleft focus parent
  bindsym $mod+bracketright focus child

  bindsym Mod5+Left  resize shrink width 10px
  bindsym Mod5+Down  resize shrink height 10px
  bindsym Mod5+Up    resize grow height 10px
  bindsym Mod5+Right resize grow width 10px

  ###### Floating Window Stuff
  # 'normal' means:
  # Drag floating windows: $mod + left cursor drag. (normal)
  # Resize  ``      ``   : $mod + right cursor drag. (normal)
  floating_modifier $mod normal
  # Toggle the current focus between tiling and floating mode
  bindsym $mod+apostrophe floating toggle
  # Swap focus between the tiling area and the floating area
  bindsym $mod+BackSpace focus mode_toggle

#####
# MOUSE CURSOR PSEUDO-MODE
  ### mouse scroll wheel
  bindsym SunProps+Home exec echo hwheel -1 | dotoolc
  bindsym SunProps+End  exec echo hwheel +1 | dotoolc
  bindsym XF86KbdBrightnessDown  exec echo wheel -1 | dotoolc
  bindsym XF86KbdBrightnessUp exec echo wheel +1 | dotoolc
  bindsym Control+XF86KbdBrightnessDown exec echo keyhold 100 ctrl; echo wheel -1 | dotoolc
  bindsym Control+XF86KbdBrightnessUp exec {echo keydown ctrl; echo wheel 1; echo keyup ctrl} | dotoolc

