( defcfg
   process-unmapped-keys yes
   windows-altgr cancel-lctl-press
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl lmet lalt           spc            ralt rmet rctl left down right
)
(deflayer qwerty
  @gxt 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    @dpd ]    \
  @cap a    s    d    f    g    h    j    k    l    @psb '    ret
  lsft z    x    c    v    b    n    m    ,    .    @sft rsft _ 
  lctl lmet _               spc           @rgr rctl rctl  _    _    _
)
(deflayer psinkbols
  _    _    _    _    _    _    _    _    _    _    _    _    _  _
S-grv S-=   [    ]   S-[  S-\  S-7   =   S-,  S-.   _    _    _  _
  _   min  S-9  S-0  S-]  S-;  S-3  S-6  S-4  S-8   _    _    _
  grv S-2  S-'   '   S-1   _   S-/  S-- S-5   \     _    _    _
  _    _    _              _              _    _    _    _    _  _
)

(defalias
  gxt (tap-hold 200 200 grv (layer-while-held xtra))
  tab (tap-hold-press 190 190 tab (layer-while-held nav))
  cap (tap-hold-press 170 170 esc (layer-while-held wincut))
  sft (tap-hold-press 100 140 / rsft)
  psb (tap-hold-press 150 150 ; (layer-while-held psinkbols))
  dpd (tap-hold 120 120 [ (layer-while-held fncur))
  rgr (tap-hold 130 130 ret ralt)
  mau (movemouse-accel-up 30 270 3 17)
  mad (movemouse-accel-down 30 270 3 17)
  mal (movemouse-accel-left 30 270 3 17)
  mar (movemouse-accel-right 30 270 3 17)
  mwl (mwheel-left 150 120)
  mwd (mwheel-down 150 120)
  mwu (mwheel-up 150 120)
  mwr (mwheel-right 150 120)
  prv C-S-tab
  nxt C-tab
  rnav (release-layer nav) ;; "layer-toggle" used below for brevity
  gr1 (tap-hold 150 150 home (multi @rnav (layer-toggle ptrtopleft)))
  gr2 (tap-hold 150 150 M-up (multi @rnav (layer-toggle ptrtopmid)))
  gr3 (tap-hold 150 150 end  (multi @rnav (layer-toggle ptrtopright)))
  gr4 (tap-hold 150 150 M-left (multi @rnav (layer-toggle ptrmidleft)))
  gr5 (tap-hold 150 150 M-down (multi @rnav (layer-toggle ptrmidmid)))
  gr6 (tap-hold 150 150 M-right (multi @rnav (layer-toggle ptrmidright)))
  gr7 (tap-hold 150 150 mute (multi @rnav (layer-toggle ptrlowleft)))
  gr8 (tap-hold 150 150 voldwn (multi @rnav (layer-toggle ptrlowmid)))
  gr9 (tap-hold 150 150 volu (multi @rnav (layer-toggle ptrlowright)))
)

(deflayer nav
  _    _    left  up  down rght _    _    _    _    _    _     _    _
  _  lrld   @gr1 @gr2 @gr3 pgup @mwu @mwl @mau @mwr volu blup  _    _
  _    _    @gr4 @gr5 @gr6 pgdn @mwd @mal @mad @mar vold bldn  _
  _   @gr7  @gr8 @gr9  f24  _   brup brdn mmid mrgt mute M-mute _
  _    _    _              mlft           bspc del  del  _     _    _
)

(deflayer wincut
  _    _    _     @prv @nxt  _    _    prnt @prv @nxt  _    _    _    _
  _   M-`   M-1   M-2  M-3  M-4  M-[   kp7  kp8   kp9  _    _    _    _
  _    _    M-5   M-6  M-7  M-8  M-'   kp4  kp5   kp6  _    _    _
  _   M-9   M-0   M--  M-=   _   M-;   kp1  kp2   kp3  _    _    _
  _    _     _               _              kp0    _   _    _    _    _
)

(deflayer fncur
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _  brup   F1   F2   F3   F4   home pgdn pgup end  _    _    _    _
  _  brdown F5   F6   F7   F8   left down up  right _    _    _
  _    F9   F10  F11  F12  _    _    _    _    _    _    _    _
  _    _    _              _              bspc del  del  _    _    _
)

(deflayer xtra
  _   volu brdn @mau brup  _    _    _    _    _    _    _    _    _
  _   vold @mal @mad @mar  _    _    _    _    _    _    _    _    _
  _   mute  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _   mrgt mmid           mlft            _    _    _    _    _    _
)

