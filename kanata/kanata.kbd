(defcfg
   process-unmapped-keys yes
   windows-altgr cancel-lctl-press
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl lmet lalt           spc            ralt rmet rctl left down right
)

(defalias
  gfk (tap-hold 100 180 grv (layer-while-held fnkp))
  cap (tap-hold 100 120 esc (multi rmet (layer-while-held wincut)))
  erm (multi lalt (layer-while-held malt)) 
  psb (tap-hold 30 100 ; (layer-while-held psinkbols))
  svm (tap-hold 100 100 / (multi lsft (layer-while-held arrows)))
  rgr (tap-hold 200 200 ret ralt)
  tnv (tap-hold 100 100 tab (layer-while-held nav))
  prv (multi (release-key rmet) C-S-tab)
  nxt (multi (release-key rmet) C-tab)
  rab (multi (release-key lalt) bspc)
  rad (multi (release-key lalt) del)
  mau (movemouse-accel-up 50 50 3 20)
  mad (movemouse-accel-down 50 50 3 20)
  mal (movemouse-accel-left 50 50 3 20)
  mar (movemouse-accel-right 50 50 3 20)
)
;; /**$ /**\ /**\ /**\ /**\ /**\ /**\ /**\ /** /**\ /**\ /**\ ##
(deflayer qwerty
  @gfk 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tnv q    w    e    r    t    y    u    i    o    p    [    ]    \
  @cap a    s    d    f    g    h    j    k    l    @psb '    ret
  lsft z    x    c    v    b    n    m    ,    .    @svm rsft _ 
  lctl lmet @erm           spc           @rgr rctl rctl _    _    _
)
 
(deflayer fnkp
  _    lrld f1   f2   f3   f4   lrld _    _    _    _    _    _    _
  _    _    f5   f6   f7   f8   _    kp7  kp8  kp9  _    _    _    _
  _    _    f9   f10  f11  f12  _    kp4  kp5  kp6  _    _    _
  _    _    _    _    _    _    _    kp1  kp2  kp3  _    _    _
  _    _    _              _              kp0   _   _    _    _    _
)

(deflayer psinkbols
  _    _    _    _    _    _    _    _    _    _    _    _    _  _
S-grv S-=   [    ]   S-[  S-\  S-7   =   S-,  S-.   _    _    _  _
  _    -   S-9  S-0  S-]  S-;  S-3  S-6  S-4  S-8   _    _    _
  grv S-2  S-'   '   S-1   _   S-/  S-- S-5   \    _    _    _
  _    _    _              _              _    _    _    _    _  _
)

(deflayer nav
  _    lrld _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    up   _    _    _    _    @mau _    _    _    _    _
  _    _   left down right _    _    @mal @mad @mar _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _    _    _    _
)

(deflayermap ( wincut )
  8 @prv 9 @nxt
)

(deflayermap (arrows)
  h (multi (release-key lsft) left) 
  j (multi (release-key lsft) down) 
  k (multi (release-key lsft) up) 
  l (multi (release-key lsft) right) 
)

(deflayer malt
  @gfk 1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    @rad  ]    \
  esc  a    s    d    f    g    h    j    k    l    @psb @rab ret
  lsft z    x    c    v    b    n    m    ,    .    @svm rsft _ 
  lctl lmet _              spc           @rab @rad  @rad  _    _    _
)
