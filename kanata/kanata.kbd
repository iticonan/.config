(deflayer malt
  grv  A-1  A-2  A-3  A-4  A-5  A-6  A-7  A-8  A-9  A-0  -    =    bspc
  tab  A-q  A-w  A-e  A-r  A-t  A-y  A-u  A-i  A-o  A-p  _    ]    \
  esc  A-a  A-s  A-d  A-f  A-g  A-h  A-j  A-k  A-l  _    _    ret
  lsft A-z  A-x  A-c  A-v  A-b  A-n  A-m  A-,  A-.  @sft rsft _ 
  lctl lmet _           A-spc             _    _     _    _   _    _
)
