  xeyb (multi ralt f9 / (setmouse $xe $yb))     
) 

;; TOP AREA
(deflayer ptrtopleft
_ 1 2 3 4 5  6    @x0y0 @x1y0 @x2y0 @x3y0  @x4y0 _ _
_ q w e r t @x0y1 @x1y1 @x2y1 @x3y1 @x4y1  [ ] \
_ a s d f g @x0y2 @x1y2 @x2y2 @x3y2 @x4y2  ' _
_ z x c v b @x0y3 @x1y3 @x2y3 @x3y3 @x4y3  _ _
_ _ _ spc  _ _ _ _ _ _
)
(deflayer ptrtopmid
_ 1 2 3 4 5 6     @x5y0 @x6y0 @x7y0 @x8y0 @x9y0 _ _
_ q w e r t @x5y1 @x6y1 @x7y1 @x8y1 @x9y1 [ ] \
_ a s d f g @x5y2 @x6y2 @x7y2 @x8y2 @x9y2 ' _
_ z x c v b @x5y3 @x6y3 @x7y3 @x8y3 @x9y3 _ _
_ _ _ spc  _ _ _ _ _ _
)
(deflayer ptrtopright
_ 1 2 3 4 5 6     @xay0 @xby0 @xcy0 @xdy0 @xey0 _ _
_ q w e r t @xay1 @xby1 @xcy1 @xdy1 @xey1  [ ] \
_ a s d f g @xay2 @xby2 @xcy2 @xdy2 @xey2  ' _
_ z x c v b @xay3 @xby3 @xcy3 @xdy3 @xey3  _ _
_ _ _ spc  _ _ _ _ _ _
)

;;;;; MID AREA 
