( defcfg
   process-unmapped-keys yes
   windows-altgr cancel-lctl-press
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft up
  lctl lmet lalt           spc            ralt rmet rctl left down right
)
(deflayer qwerty
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab q    w    e    r    t    y    u    i    o    p    @dpd ]    \
  @cap a    s    d    f    g    h    j    k    l    @psb '    ret
  lsft z    x    c    v    b    n    m    ,    .    @sft rsft _ 
  lctl lmet _               spc           @rgr rctl rctl  _    _    _
)
(deflayer psinkbols
  _    _    _    _    _    _    _    _    _    _    _    _    _  _
S-grv S-=   [    ]   S-[  S-\  S-7   =   S-,  S-.   _    _    _  _
  _   min  S-9  S-0  S-]  S-;  S-3  S-6  S-4  S-8   _    _    _
  grv S-2  S-'   '   S-1   _   S-/  S-- S-5   \     _    _    _
  _    _    _              _              _    _    _    _    _  _
)

(defalias
  tab (tap-hold-press 190 190 tab (layer-while-held nav))
  cap (tap-hold-press 170 170 esc (layer-while-held wincut))
  sft (tap-hold 100 140 / rsft)
  psb (tap-hold 150 150 ; (layer-while-held psinkbols))
  dpd (tap-hold 120 120 [ (layer-while-held fncur))
  rgr (tap-hold 130 130 ret ralt)
  mau (movemouse-accel-up 50 50 3 23)
  mad (movemouse-accel-down 50 50 3 23)
  mal (movemouse-accel-left 50 50 3 23)
  mar (movemouse-accel-right 50 50 3 23)
  mwl (mwheel-left 150 120)
  mwd (mwheel-down 150 120)
  mwu (mwheel-up 150 120)
  mwr (mwheel-right 150 120)
  rnav (release-layer nav) ;; "layer-toggle" used below for brevity
  w15 (tap-hold 150 150 home (multi @rnav (layer-toggle ptrtopleft) F15 w))
  e15 (tap-hold 150 150 M-up (multi @rnav (layer-toggle ptrtopmid) F15 e))
  r15 (tap-hold 150 150 end  (multi @rnav (layer-toggle ptrtopright) F15 r))
  s15 (tap-hold 150 150 M-left (multi @rnav (layer-toggle ptrmidleft) F15 s))
  d15 (tap-hold 150 150 M-down (multi @rnav (layer-toggle ptrmidmid) F15 d))
  f15 (tap-hold 150 150 M-right (multi @rnav (layer-toggle ptrmidright) F15 f))
  z15 (tap-hold 150 150 mute (multi @rnav (layer-toggle ptrlowleft) F15 z))
  x15 (tap-hold 150 150 voldwn (multi @rnav (layer-toggle ptrlowmid) F15 x))
  c15 (tap-hold 150 150 volu (multi @rnav (layer-toggle ptrlowright) F15 c))
)

(deflayer nav
  _    _    left up  down right _    _    _    _    _    _    _    _
  _  lrld   @w15 @e15 @r15 pgup @mwu @mwl @mau @mwr _    _    _    _
  _    _    @s15 @d15 @f15 pgdn @mwd @mal @mad @mar _    _    _
  _   @z15  @x15 @c15  f24  _   _    mlft mmid mrgt _    _    _
  _    _    _              mlft           bspc del  del  _    _    _
)

(deflayer wincut
  _    _    _  C-S-tab C-tab  _    _   _ C-S-tab C-tab _    _    _    _
  _   lrld  M-1   M-2  M-3  M-4  M-[   kp7  kp8   kp9  _    _    _    _
  _    _    M-5   M-6  M-7  M-8  M-'   kp4  kp5   kp6  _    _    _
  _   M-9   M-0   M--  M-=   _   M-;   kp1  kp2   kp3  _    _    _
  _    _     _              _              kp0     _   _    _    _    _
)

(deflayer fncur
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _  lrld   F1   F2   F3   F4   home pgdn pgup end  _    _    _    _
  _    _    F5   F6   F7   F8   left down up  right _    _    _
  _    F9   F10  F11  F12  _    _    _    _    _    _    _    _
  _    _    _              _              bspc del  del  _    _    _
)

;; TOP AREA
(deflayer ptrtopleft
_ 1 2 3 4 5 6 
(setmouse $x0 $y0) (setmouse $x1 $y0) (setmouse $x2 $y0) (setmouse $x3 $y0)  (setmouse $x4 $y0) _ _
_ q w e r t
(setmouse $x0 $y1) (setmouse $x1 $y1) (setmouse $x2 $y1) (setmouse $x3 $y1)  (setmouse $x4 $y1) [ ] \
_ a s d f g
(setmouse $x0 $y2) (setmouse $x1 $y2) (setmouse $x2 $y2) (setmouse $x3 $y2)  (setmouse $x4 $y2) ' _
_ z x c v b
(setmouse $x0 $y3) (setmouse $x1 $y3) (setmouse $x2 $y3) (setmouse $x3 $y3)  (setmouse $x4 $y3) _ _
_ _ _ spc  _ _ _ _ _ _
)
(deflayer ptrtopmid
_ 1 2 3 4 5 6 
(setmouse $x5 $y0) (setmouse $x6 $y0) (setmouse $x7 $y0) (setmouse $x8 $y0)  (setmouse $x9 $y0) _ _
_ q w e r t
(setmouse $x5 $y1) (setmouse $x6 $y1) (setmouse $x7 $y1) (setmouse $x8 $y1)  (setmouse $x9 $y1) [ ] \
_ a s d f g
(setmouse $x5 $y2) (setmouse $x6 $y2) (setmouse $x7 $y2) (setmouse $x8 $y2)  (setmouse $x9 $y2) ' _
_ z x c v b
(setmouse $x5 $y3) (setmouse $x6 $y3) (setmouse $x7 $y3) (setmouse $x8 $y3)  (setmouse $x9 $y3) _ _
_ _ _ spc  _ _ _ _ _ _
)
(deflayer ptrtopright
_ 1 2 3 4 5 6 
(setmouse $xa $y0) (setmouse $xb $y0) (setmouse $xc $y0) (setmouse $xd $y0)  (setmouse $xe $y0) _ _
_ q w e r t                                                                                   
(setmouse $xa $y1) (setmouse $xb $y1) (setmouse $xc $y1) (setmouse $xd $y1)  (setmouse $xe $y1) [ ] \
_ a s d f g                                                                                   
(setmouse $xa $y2) (setmouse $xb $y2) (setmouse $xc $y2) (setmouse $xd $y2)  (setmouse $xe $y2) ' _
_ z x c v b                                                                                   
(setmouse $xa $y3) (setmouse $xb $y3) (setmouse $xc $y3) (setmouse $xd $y3)  (setmouse $xe $y3) _ _
_ _ _ spc  _ _ _ _ _ _
)

